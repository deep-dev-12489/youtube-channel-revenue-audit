# ==========================================
# TubePulse - Universal Environment Configuration
# ==========================================
# Copy this file to .env.local to configure your API keys:
# cp .env.example .env.local

# Optional: YouTube Data API v3 Key (from Google Cloud Console)
# If left empty, the app runs in Zero-Key Public Scraping mode automatically!
YOUTUBE_API_KEY=

# Optional: Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
# If left empty, Gemini insights fallback gracefully to algorithmic catalog heuristics.
GEMINI_API_KEY=

# Port configuration (default: 3000)
PORT=3000
