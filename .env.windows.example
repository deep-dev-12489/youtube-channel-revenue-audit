# ==========================================
# TubePulse - Windows Environment Setup
# ==========================================
# In Windows PowerShell:
# Copy-Item .env.windows.example .env.local
# Or in CMD:
# copy .env.windows.example .env.local

# Optional: YouTube Data API v3 Key (from Google Cloud Console)
# If left empty, the app runs in Zero-Key Public Scraping mode automatically!
YOUTUBE_API_KEY=

# Optional: Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Windows Development Port (default: 3000)
PORT=3000
